generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  JEFE_DESPACHO
  GESTOR
}

enum Permiso {
  RADICAR_EXPEDIENTES
  ANALIZAR_TUTELAS
  GENERAR_PROVIDENCIAS
  APROBAR_PROVIDENCIAS
  ADMINISTRAR_EQUIPO
  CONFIGURAR_DESPACHO
}

model Usuario {
  id                 String    @id @default(cuid())
  nombre             String
  documento          String?
  cargo              String
  email              String    @unique
  rol                Rol       @default(GESTOR)
  activo             Boolean   @default(true)
  permisos           Permiso[]
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt

  @@map("usuarios")
}
